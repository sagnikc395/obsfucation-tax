# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Notebooks
.ipynb_checkpoints/

# Virtual environments
.venv

.env 
analysis/

# Run artifacts: regenerated by the notebooks, too large for git.
# results/upload/ is the exception -- the slim npz the attack notebook needs, small
# enough to travel with a clone so Colab does not have to re-upload it.
results/*
!results/.gitkeep
!results/upload/
